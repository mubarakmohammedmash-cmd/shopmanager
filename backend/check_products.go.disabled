package main

import (
	"database/sql"
	"fmt"
	"log"

	_ "modernc.org/sqlite"
)

func main() {
	db, err := sql.Open("sqlite", "shop.db")
	if err != nil {
		log.Fatal(err)
	}
	defer db.Close()

	rows, err := db.Query("SELECT id, name, stock, selling_price FROM products")
	if err != nil {
		log.Fatal(err)
	}
	defer rows.Close()

	count := 0
	for rows.Next() {
		var id, stock int
		var name string
		var price int64

		if err := rows.Scan(&id, &name, &stock, &price); err != nil {
			log.Fatal(err)
		}

		fmt.Printf("ID: %d | Product: %s | Stock: %d | Price: %d kobo\n",
			id, name, stock, price)
		count++
	}

	if err := rows.Err(); err != nil {
		log.Fatal(err)
	}

	fmt.Printf("\nTotal products: %d\n", count)
}
